{
  "name": "goobs-frontend",
  "version": "0.200",
  "type": "module",
  "description": "A comprehensive React-based libary for building modern web applications",
  "license": "MIT",
  "main": "./dist/goobs-frontend.es.js",
  "module": "./dist/goobs-frontend.es.js",
  "types": "./dist/index.d.ts",
  "sideEffects": ["*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/goobs-frontend.es.js",
      "default": "./dist/goobs-frontend.es.js"
    },
    "./styles": "./dist/goobs-frontend.css",
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.js"
    },
    "./umd": {
      "types": "./dist/index.d.ts",
      "default": "./dist/goobs-frontend.umd.js"
    },
    "./fonts": "./fonts/goobs-fonts.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "prepublishOnly": "npm run typecheck && npm run lint:all && npm run build",
    "test-storybook": "test-storybook --url http://127.0.0.1:6006",
    "start": "storybook dev -p 6006",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.stories.json",
    "typecheck:file": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{jsx,ts,tsx}\" --fix --max-warnings=0",
    "lint:file": "eslint --fix --max-warnings=0",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:stories": "eslint \"src/**/*.stories.tsx\" \".storybook/**/*.{ts,tsx}\" --max-warnings=0",
    "lint:styles-props": "bun scripts/lint-styles-props-read.ts",
    "lint:coverage": "bun scripts/lint-story-coverage.ts",
    "lint:all": "npm run lint && npm run lint:css && npm run lint:stories && npm run lint:styles-props && npm run lint:coverage",
    "chromatic": "chromatic",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^2.0.1",
    "@types/lodash": "^4.17.24",
    "date-fns": "^4.4.0",
    "eslint-config-next": "^16.2.10",
    "formik": "^2.4.9",
    "highlight.js": "^11.11.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lodash": "^4.18.1",
    "otplib": "^13.4.1",
    "qrcode": "^1.5.4",
    "slate": "^0.124.1",
    "slate-dom": "^0.124.1",
    "slate-history": "^0.113.1",
    "slate-react": "^0.125.1",
    "typescript-eslint": "^8.63.0",
    "zod": "^4.4.3",
    "zod-formik-adapter": "^2.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/compat": "^2.1.0",
    "@storybook/addon-a11y": "^10.4.6",
    "@storybook/addon-docs": "^10.4.6",
    "@storybook/addon-links": "^10.4.6",
    "@storybook/nextjs": "^10.4.6",
    "@storybook/react": "^10.4.6",
    "@storybook/test-runner": "^0.24.4",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.5.2",
    "chromatic": "^18.0.1",
    "eslint": "^10.6.0",
    "eslint-plugin-jsdoc": "^63.0.12",
    "eslint-plugin-storybook": "^10.4.6",
    "next": "^16.2.10",
    "prettier": "^3.9.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "storybook": "^10.4.6",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.4",
    "vite-plugin-css-injected-by-js": "^5.0.1",
    "vite-plugin-dts": "^5.0.3"
  },
  "peerDependencies": {
    "next": "^16",
    "react": "^19",
    "react-dom": "^19"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "fonts"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/goobz22/goobs-frontend.git"
  },
  "bugs": {
    "url": "https://github.com/goobz22/goobs-frontend/issues"
  },
  "homepage": "https://github.com/goobz22/goobs-frontend#readme",
  "keywords": [
    "accordion",
    "button",
    "card",
    "code-copy",
    "confirmationCodeInput",
    "confirmationCode",
    "complexeditor",
    "contentSection",
    "dataGrid",
    "dialog",
    "dropdown",
    "front-end",
    "form",
    "formData",
    "formDataGrid",
    "grid",
    "incrementNumberField",
    "material-ui",
    "mfa",
    "multiSelectChip",
    "navigation",
    "next.js",
    "node.js",
    "number",
    "password",
    "phonenumber",
    "popup",
    "projectBoard",
    "qrCode",
    "radioButton",
    "radioGroup",
    "react-components",
    "responsive",
    "responsive-design",
    "searchbar",
    "stepper",
    "storybook",
    "tabs",
    "textField",
    "tooltip",
    "transferList",
    "2fa",
    "two-factor-auth",
    "ui-library"
  ]
}
