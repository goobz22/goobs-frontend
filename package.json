{
  "name": "goobs-frontend",
  "version": "0.123.01",
  "type": "module",
  "description": "A comprehensive React-based libary for building modern web applications",
  "license": "MIT",
  "main": "./dist/goobs-frontend.umd.js",
  "module": "./dist/goobs-frontend.es.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/goobs-frontend.es.js",
      "require": "./dist/goobs-frontend.umd.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "bun run lint && tsc && vite build && bun run format",
    "preview": "vite preview",
    "prepublishOnly": "bun run build",
    "start": "storybook dev -p 6006",
    "typecheck": "tsc --noEmit",
    "typecheck:file": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{jsx,ts,tsx}\" --fix --max-warnings=0",
    "lint:file": "eslint --fix --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^1",
    "@storybook/addon-links": "^10",
    "@types/lodash": "^4",
    "date-fns": "^4",
    "eslint-config-next": "^16",
    "formik": "^2",
    "highlight.js": "^11",
    "html2canvas": "^1",
    "jspdf": "^3",
    "lodash": "^4",
    "next": "^16",
    "otplib": "^12",
    "qrcode": "^1",
    "slate": "^0",
    "slate-dom": "^0",
    "slate-history": "^0",
    "slate-react": "^0",
    "storybook": "^10",
    "typescript-eslint": "^8",
    "zod": "^4",
    "zod-formik-adapter": "^2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4",
    "@storybook/addon-onboarding": "^10",
    "@storybook/nextjs": "^10",
    "@storybook/react": "^10",
    "@types/qrcode": "^1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "ajv": "^8",
    "autoprefixer": "^10",
    "chromatic": "^13",
    "eslint": "^9",
    "prettier": "^3",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^5",
    "vite": "^7",
    "vite-plugin-dts": "^4",
    "vite-tsconfig-paths": "^5"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/goobz22/goobs-frontend.git"
  },
  "bugs": {
    "url": "https://github.com/goobz22/goobs-frontend/issues"
  },
  "homepage": "https://github.com/goobz22/goobs-frontend#readme",
  "keywords": [
    "accordion",
    "button",
    "card",
    "code-copy",
    "confirmationCodeInput",
    "confirmationCode",
    "complexeditor",
    "contentSection",
    "customizable-components",
    "dataGrid",
    "dialog",
    "dropdown",
    "front-end",
    "form",
    "formData",
    "formDataGrid",
    "grid",
    "incrementNumberField",
    "material-ui",
    "mfa",
    "multiSelectChip",
    "navigation",
    "next.js",
    "node.js",
    "number",
    "password",
    "phonenumber",
    "popup",
    "pricing-table",
    "projectBoard",
    "qrCode",
    "radioButton",
    "radioGroup",
    "react-components",
    "responsive",
    "responsive-design",
    "searchbar",
    "stepper",
    "storybook",
    "tabs",
    "textField",
    "tooltip",
    "transferList",
    "2fa",
    "two-factor-auth",
    "typescript",
    "typography",
    "ui-library"
  ],
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
