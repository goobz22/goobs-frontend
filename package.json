{
  "name": "goobs-frontend",
  "version": "0.126.01",
  "type": "module",
  "description": "A comprehensive React-based libary for building modern web applications",
  "license": "MIT",
  "main": "./dist/goobs-frontend.es.js",
  "module": "./dist/goobs-frontend.es.js",
  "types": "./dist/index.d.ts",
  "sideEffects": ["*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/goobs-frontend.es.js",
      "default": "./dist/goobs-frontend.es.js"
    },
    "./styles": "./dist/goobs-frontend.css",
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.js"
    },
    "./umd": {
      "types": "./dist/index.d.ts",
      "default": "./dist/goobs-frontend.umd.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "prepublishOnly": "npm run build",
    "start": "storybook dev -p 6006",
    "typecheck": "tsc --noEmit",
    "typecheck:file": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{jsx,ts,tsx}\" --fix --max-warnings=0",
    "lint:file": "eslint --fix --max-warnings=0",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:all": "npm run lint && npm run lint:css",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^1.8.1",
    "@storybook/addon-links": "^10.4.1",
    "@types/lodash": "^4.17.24",
    "date-fns": "^4.4.0",
    "eslint-config-next": "^16.2.6",
    "formik": "^2.4.9",
    "highlight.js": "^11.11.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lodash": "^4.18.1",
    "next": "^16.2.6",
    "otplib": "^13.4.1",
    "qrcode": "^1.5.4",
    "slate": "^0.124.1",
    "slate-dom": "^0.124.1",
    "slate-history": "^0.113.1",
    "slate-react": "^0.124.2",
    "storybook": "^10.4.1",
    "typescript-eslint": "^8.60.0",
    "zod": "^4.4.3",
    "zod-formik-adapter": "^2.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/compat": "^2.1.0",
    "@storybook/addon-onboarding": "^10.4.1",
    "@storybook/nextjs": "^10.4.1",
    "@storybook/react": "^10.4.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "ajv": "^8.20.0",
    "autoprefixer": "^10.5.0",
    "chromatic": "^17.1.0",
    "eslint": "^10.4.1",
    "prettier": "^3.8.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-css-injected-by-js": "^5.0.1",
    "vite-plugin-dts": "^5.0.1"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/goobz22/goobs-frontend.git"
  },
  "bugs": {
    "url": "https://github.com/goobz22/goobs-frontend/issues"
  },
  "homepage": "https://github.com/goobz22/goobs-frontend#readme",
  "keywords": [
    "accordion",
    "button",
    "card",
    "code-copy",
    "confirmationCodeInput",
    "confirmationCode",
    "complexeditor",
    "contentSection",
    "dataGrid",
    "dialog",
    "dropdown",
    "front-end",
    "form",
    "formData",
    "formDataGrid",
    "grid",
    "incrementNumberField",
    "material-ui",
    "mfa",
    "multiSelectChip",
    "navigation",
    "next.js",
    "node.js",
    "number",
    "password",
    "phonenumber",
    "popup",
    "projectBoard",
    "qrCode",
    "radioButton",
