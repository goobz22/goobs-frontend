{
  "name": "goobs-frontend",
  "version": "0.202.0",
  "type": "module",
  "description": "A comprehensive React-based libary for building modern web applications",
  "license": "MIT",
  "main": "./dist/goobs-frontend.es.js",
  "module": "./dist/goobs-frontend.es.js",
  "types": "./dist/index.d.ts",
  "sideEffects": ["*.css"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/goobs-frontend.es.js",
      "default": "./dist/goobs-frontend.es.js"
    },
    "./styles": "./dist/goobs-frontend.css",
    "./umd": {
      "types": "./dist/index.d.ts",
      "default": "./dist/goobs-frontend.umd.js"
    },
    "./fonts": "./fonts/goobs-fonts.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "prepublishOnly": "npm run typecheck && npm run lint:all && npm run build && npm run lint:package && npm run lint:budget && npm run lint:api",
    "test-storybook": "test-storybook --url http://127.0.0.1:6006",
    "start": "storybook dev -p 6006",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.stories.json",
    "typecheck:file": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{jsx,ts,tsx}\" --fix --max-warnings=0",
    "lint:file": "eslint --fix --max-warnings=0",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:stories": "eslint \"src/**/*.stories.tsx\" \".storybook/**/*.{ts,tsx}\" --max-warnings=0",
    "lint:styles-props": "bun scripts/lint-styles-props-read.ts",
    "lint:coverage": "bun scripts/lint-story-coverage.ts",
    "lint:a11y": "bun scripts/lint-a11y.ts",
    "lint:circular": "bun scripts/lint-circular-imports.ts",
    "lint:package": "bun scripts/lint-package-exports.ts",
    "lint:budget": "bun scripts/lint-bundle-budget.ts",
    "lint:api": "bun scripts/lint-api-surface.ts",
    "lint:drift": "bun scripts/lint-drift.ts",
    "lint:rtl": "bun scripts/lint-rtl-spacing.ts",
    "lint:touch-target": "bun scripts/lint-touch-target-height.ts",
    "lint:meeting-affordance": "bun scripts/lint-meeting-affordance-gate.ts",
    "test": "bun test ./scripts/__tests__",
    "lint:all": "npm run lint && npm run lint:css && npm run lint:stories && npm run lint:styles-props && npm run lint:coverage && npm run lint:a11y && npm run lint:circular && npm run lint:drift && npm run lint:rtl && npm run lint:touch-target && npm run lint:meeting-affordance && npm run test",
    "chromatic": "chromatic",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "highlight.js": "^11.12.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lodash": "^4.18.1",
    "qrcode": "^1.5.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-links": "^10.6.0",
    "@storybook/nextjs": "^10.6.0",
    "@storybook/react": "^10.6.0",
    "@storybook/test-runner": "^0.24.5",
    "@types/lodash": "^4.17.25",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "chromatic": "^18.7.2",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.4",
    "eslint-plugin-jsdoc": "^64.3.5",
    "eslint-plugin-storybook": "^10.6.0",
    "next": "^16.3.4",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.6.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0"
  },
  "peerDependencies": {
    "next": "^16",
    "react": "^19",
    "react-dom": "^19"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    }
  },
  "files": [
    "dist",
    "fonts"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/goobz22/goobs-frontend.git"
  },
  "bugs": {
    "url": "https://github.com/goobz22/goobs-frontend/issues"
  },
  "homepage": "https://github.com/goobz22/goobs-frontend#readme",
  "keywords": [
    "2fa",
    "accordion",
    "button",
    "calendar",
    "card",
    "code-copy",
    "component-library",
    "confirmation-code-input",
    "css-modules",
    "data-grid",
    "date-picker",
    "design-system",
    "design-tokens",
    "dialog",
    "drag-and-drop",
    "dropdown",
    "form",
    "form-validation",
    "front-end",
    "grid",
    "icons",
    "kanban",
    "mfa",
    "multi-select",
    "navigation",
    "nextjs",
    "number-input",
    "pagination",
    "password",
    "phone-input",
    "popup",
    "project-board",
    "qr-code",
    "radio-group",
    "react",
    "react-components",
    "responsive",
    "responsive-design",
    "rich-text-editor",
    "searchbar",
    "slate",
    "stepper",
    "storybook",
    "tabs",
    "text-field",
    "tooltip",
    "transfer-list",
    "tree-view",
    "two-factor-auth",
    "typescript",
    "ui-library",
    "zod"
  ]
}
