{
  "buildCommand": "node -r ./patch-eslint-scope.js ./node_modules/.bin/storybook build",
  "devCommand": "bun run storybook",
  "installCommand": "bun install --frozen-lockfile",
  "framework": null,
  "outputDirectory": "./storybook-static",
  "env": {
    "SKIP_ESM_EXTERNALS": "true",
    "NODE_OPTIONS": "--max-old-space-size=4096"
  }
}
