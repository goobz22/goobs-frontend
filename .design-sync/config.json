    "Slide": { "cardMode": "column" },
    "Stepper": { "cardMode": "column" },
    "Switch": { "cardMode": "column" },
    "TextField": { "cardMode": "column" },
    "ToggleButton": { "cardMode": "column" },
    "TransferList": { "cardMode": "column" },
    "TreeView": { "cardMode": "column" },
    "CustomToolbar": { "cardMode": "single", "primaryStory": "LightTheme" },
    "DataGrid": { "cardMode": "single", "primaryStory": "Desktop" },
