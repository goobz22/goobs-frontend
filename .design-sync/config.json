{
  "projectId": "02a71111-4719-4054-9cfe-3ce9fc9a438d",
  "pkg": "goobs-frontend",
  "globalName": "GoobsFrontend",
  "shape": "storybook",
  "storybookConfigDir": ".storybook",
  "storybookStatic": ".design-sync/sb-reference",
  "buildCmd": "bun run build",
  "cssEntry": "dist/goobs-frontend.css",
  "entry": "./dist/goobs-frontend.es.js",
  "tsconfig": ".design-sync/bundle-tsconfig.json",
  "readmeHeader": ".design-sync/conventions.md",
  "extraFonts": "fonts/goobs-fonts.css",
  "storyImports": {
    "bundle": ["/components/Icons/", "/components/Metric/"],
    "shim": ["/components/Form/context"]
  },
  "titleMap": {
    "Button": "CustomButton",
    "ComplexTextEditor": "ComplexEditor",
    "MACAddress": "MACAddressField",
    "VLAN": "VLANField",
    "InternalIncrement": "InternalIncrementNumberField",
    "ExternalIncrement": "ExternalIncrementNumberField",
    "Address": "IPAddressField",
    "CIDR": "CIDRField",
    "Subnet": "SubnetField",
    "Supernet": "SupernetField",
    "Password": "PasswordField",
    "Percentage": "PercentageField",
    "PhoneNumber": "PhoneNumberField",
    "Search": "SearchBar",
    "Text": "TextField",
    "USD": "USDField",
    "Metric": "MetricCard",
    "Toolbar": "CustomToolbar",
    "Tooltip": "StyledTooltip",
    "CVV": "CVVField",
    "QRCode": "QRCodeComponent"
  },
  "overrides": {
    "Accordion": { "cardMode": "column" },
    "BigCalendar": { "cardMode": "column" },
    "Fade": { "cardMode": "column" },
    "Zoom": { "cardMode": "column" },
    "MenuItem": { "cardMode": "column" },
    "Pagination": { "cardMode": "column" },
    "QRCodeComponent": { "cardMode": "column" },
    "SearchableHistory": { "cardMode": "column" },
    "Select": { "cardMode": "column" },
    "Slider": { "cardMode": "column" },
    "TimeField": { "cardMode": "column" },
    "Content": { "cardMode": "column" },
    "Alert": { "cardMode": "column" },
    "ComplexEditor": { "cardMode": "column" },
    "ConfirmationCodeInput": { "cardMode": "column" },
    "DateField": { "cardMode": "column" },
    "DateRange": { "cardMode": "column" },
    "DetailField": { "cardMode": "column" },
    "Divider": { "cardMode": "column" },
    "Dropdown": { "cardMode": "column" },
    "Form": { "cardMode": "column" },
    "IconButton": { "cardMode": "column" },
    "List": { "cardMode": "column" },
    "ListItemCard": { "cardMode": "column" },
    "Markdown": { "cardMode": "column" },
    "MetricCard": { "cardMode": "column" },
    "Panel": { "cardMode": "column" },
    "PasswordField": { "cardMode": "column" },
    "PercentageField": { "cardMode": "column" },
    "PhoneNumberField": { "cardMode": "column" },
