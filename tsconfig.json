{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    // "rootDir": "./src",
    // "outDir": "./dist",
    // `baseUrl` was removed for TypeScript 6 (deprecated, removed in TS 7).
    // Since TS 4.1, `paths` is resolved relative to this tsconfig's directory,
    // so the relative `./src/*` mapping keeps working without `baseUrl`.
    "paths": {
      "@/*": ["./src/*"]
    },
    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "esnext",
    "target": "esnext",
    // `vite/client` is the ONLY source of the `*.module.css` / `*.css` ambient module
    // declarations every component's `import styles from './X.module.css'` relies on.
    // With `"types": []` it was reached only through a machine-local, gitignored
    // `src/vite-env.d.ts` (`src/**/*.d.ts` is ignored below to hide tsc's own
    // declaration emit), so a fresh clone failed `typecheck` with 373× TS2307 +
    // 1× TS2882 (2026-09-07, mkgol rebuild). Declaring it here makes the dependency
    // tracked instead of ambient.
    "types": ["vite/client"],
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node
    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,
    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "verbatimModuleSyntax": false,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "noEmit": false,
    "incremental": true,
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": ["node_modules", "dist", "**/*.stories.ts", "**/*.stories.tsx"]
}
